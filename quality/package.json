{
  "name": "lat-quiz-webbkvalitet",
  "private": true,
  "type": "module",
  "description": "Kvalitetskontroller som körs i CI: lint, typer, röktest, HTML, tillgänglighet, Lighthouse, länkar och sidvikt. Allt utom lint och typer kontrollerar den byggda sidan i _site/.",
  "scripts": {
    "lint": "cd .. && eslint --config quality/eslint.config.js .",
    "types": "tsc -p tsconfig.json",
    "html": "java -jar node_modules/vnu-jar/build/dist/vnu.jar --errors-only --also-check-css ../_site/index.html ../_site/host.html ../_site/play.html ../_site/css/style.css",
    "peer": "peerjs --host 127.0.0.1 --port 9000",
    "axe": "node axe.mjs",
    "lighthouse": "node lighthouse.mjs",
    "links": "linkinator http://localhost:8080/index.html --recurse",
    "page-weight": "node page-weight.mjs",
    "smoke": "node smoke.mjs && EXTRA=1 ALLA=1 node smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "peer": "1.0.2",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vnu-jar": "26.10.9"
  },
  "overrides": {
    "ws": "^8.18.0"
  }
}
