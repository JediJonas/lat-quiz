{
  "name": "lat-quiz-kontroller",
  "private": true,
  "type": "module",
  "description": "Kvalitetskontroller som körs i CI: HTML, tillgänglighet, Lighthouse, länkar och sidvikt.",
  "scripts": {
    "html": "java -jar node_modules/vnu-jar/build/dist/vnu.jar --errors-only --also-check-css ../index.html ../host.html ../play.html ../verktyg/spotify-id.html ../css/style.css",
    "peer": "peerjs --host 127.0.0.1 --port 9000",
    "axe": "node axe.mjs",
    "lighthouse": "node lighthouse.mjs",
    "lankar": "linkinator http://localhost:8080/index.html --recurse",
    "sidvikt": "node sidvikt.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "lighthouse": "13.5.0",
    "linkinator": "8.1.0",
    "peer": "1.0.2",
    "playwright-core": "1.64.0",
    "vnu-jar": "26.10.9"
  },
  "overrides": {
    "ws": "^8.18.0"
  }
}
